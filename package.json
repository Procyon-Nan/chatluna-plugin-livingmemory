{
    "name": "chatluna-plugin-livingmemory",
    "version": "0.0.11",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "description": "LivingSystem 生态下构筑的长期记忆插件，让 bot 的记忆带上生动的人格化色彩。通过异步、非阻塞的记忆召回和记忆整理流程让 bot 记叙共度的时光。",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Procyon-Nan/chatluna-plugin-livingmemory.git"
    },
    "keywords": [
        "chatluna-plugin"
    ],
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./package.json": "./package.json",
        "./client": {
            "types": "./client/index.ts",
            "default": "./client/index.ts"
        }
    },
    "files": [
        "lib",
        "README.md",
        "client",
        "src/contracts",
        "dist"
    ],
    "scripts": {
        "dev": "node scripts/build-client.mjs --watch",
        "build": "tsc -p tsconfig.json && node scripts/build.mjs",
        "clean": "node scripts/clean.mjs",
        "pub": "npm run clean && npm run build && npm publish",
        "test": "node --test --experimental-transform-types --import ./tests/setup.ts \"tests/**/*.spec.ts\""
    },
    "dependencies": {
        "@chatluna/server": "*",
        "@chatluna/ui-server": "*",
        "@electric-sql/pglite": "0.5.11",
        "@electric-sql/pglite-pgvector": "0.0.12",
        "schemastery": "^3.18.0"
    },
    "peerDependencies": {
        "@chatluna/agent": "*",
        "@chatluna/ai": "*",
        "@chatluna/ai-runtime": "*",
        "@chatluna/chat": "*",
        "@chatluna/chat-observer": "*",
        "@chatluna/conversations": "*",
        "@chatluna/core": "*",
        "@chatluna/message": "*",
        "@chatluna/preset": "*",
        "@chatluna/routing": "*",
        "@chatluna/satori": "*",
        "@chatluna/schema": "*",
        "@chatluna/tool": "*",
        "@chatluna/ui-schema-registry": "*",
        "@chatluna/utils": "*",
        "@cordisjs/plugin-database": "^4.1.1",
        "cordis": "^4.0.0-rc.12"
    },
    "devDependencies": {
        "@chatluna/adapter-webui": "*",
        "@chatluna/permission": "*",
        "@chatluna/runtime-webui": "*",
        "@chatluna/ui-client": "*",
        "@chatluna/ui-kit": "*",
        "@chatluna/ui-schema-form": "*",
        "@chatluna/ui-storage": "*",
        "@cordisjs/plugin-database": "^4.1.1",
        "@cordisjs/plugin-database-sqlite": "^5.1.1",
        "@cordisjs/plugin-loader": "^1.0.0-rc.9",
        "@cordisjs/plugin-timer": "^1.1.4",
        "@cordisjs/unyaml": "2.0.3",
        "@tanstack/react-query": "^5.101.4",
        "@types/node": "24.13.3",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "cordis": "^4.0.0-rc.12",
        "koishi": "npm:@koishijs/core@4.18.11",
        "react": "*",
        "react-dom": "*",
        "rolldown": "1.2.16",
        "typescript": "7.0.2",
        "vite": "^8.2.1"
    },
    "cordis": {
        "description": {
            "zh": "LivingSystem 生态下构筑的长期记忆插件，让 bot 的记忆带上生动的人格化色彩。通过异步、非阻塞的记忆召回和记忆整理流程让 bot 记叙共度的时光。",
            "en": "Built for the LivingSystem ecosystem, this long-term memory plugin gives your bot’s memories a voice of their own. Your bot recalls and organizes memories in the background, telling the story of your time together without pausing the conversation."
        }
    }
}
